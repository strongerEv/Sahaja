# --- Mode demo ---
# Selama NEXT_PUBLIC_SUPABASE_URL di bawah masih kosong, aplikasi otomatis
# berjalan dengan data contoh: semua halaman bisa dijelajahi, tapi tidak ada
# yang tersimpan. Begitu kredensial Supabase diisi, mode demo mati sendiri.
# Isi '1' untuk memaksa mode demo walau kredensial Supabase sudah ada.
# NEXT_PUBLIC_DEMO_MODE=1

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Catatan: service-role key TIDAK dibutuhkan aplikasi ini. Alur tamu anonim
# (RSVP, ucapan, statistik kunjungan) memakai fungsi SECURITY DEFINER di
# database, jadi tidak ada kunci istimewa yang perlu disimpan di runtime.

# --- App ---
# Dipakai untuk generate link undangan & link personalisasi per tamu.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
